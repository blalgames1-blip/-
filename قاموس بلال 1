<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>قاموس الكلمات الناطق الشامل</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8fafc;
            margin: 0;
            padding: 15px;
            direction: rtl;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            background: #ffffff;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        }

        h1 {
            text-align: center;
            color: #1e3a8a;
            margin: 10px 0 5px;
            font-size: 24px;
        }

        .subtitle {
            text-align: center;
            color: #64748b;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .table-responsive {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th {
            background-color: #1e293b;
            color: white;
            padding: 12px;
            font-size: 15px;
            border: 1px solid #334155;
            text-align: center;
        }

        td {
            padding: 12px;
            border: 1px solid #e2e8f0;
            vertical-align: middle;
        }

        tr:nth-child(even) {
            background-color: #f1f5f9;
        }

        tr:hover {
            background-color: #e2e8f0;
        }

        .num-col {
            width: 5%;
            text-align: center;
            font-weight: bold;
            color: #475569;
        }

        .meaning-col {
            width: 25%;
            font-weight: bold;
            color: #0f172a;
            font-size: 15px;
        }

        .word-col {
            width: 70%;
            direction: ltr;
            text-align: left;
        }

        .pron-text {
            direction: rtl;
            text-align: right;
            font-size: 13px;
            color: #d97706;
            background: #fef3c7;
            padding: 3px 8px;
            border-radius: 4px;
            display: inline-block;
            margin-bottom: 6px;
            border: 1px solid #fde68a;
            font-weight: bold;
        }

        .words-container {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            align-items: center;
        }

        .clickable-word {
            background: #eff6ff;
            color: #1e3a8a;
            padding: 4px 8px;
            border-radius: 5px;
            border: 1px solid #bfdbfe;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .clickable-word:hover {
            background: #2563eb;
            color: white;
            border-color: #1d4ed8;
        }

        .separator {
            color: #94a3b8;
            font-weight: bold;
        }

        .play-all-btn {
            background: #10b981;
            color: white;
            border: none;
            padding: 5px 10px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 13px;
            font-weight: bold;
            margin-left: 8px;
        }

        .play-all-btn:hover {
            background: #059669;
        }
    </style>
</head>
<body>

