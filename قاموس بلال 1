        function speakText(text) {
            window.speechSynthesis.cancel();
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'en-US';
            utterance.rate = 0.85;
            window.speechSynthesis.speak(utterance);
        }

        const tbody = document.getElementById('table-body');

        wordsData.forEach(item => {
            const tr = document.createElement('tr');

            // تقسيم الترادفات وتجميع أزرار تفاعلية لكل كلمة
            const parts = item.word.split('=').map(p => p.trim());
            let wordsHTML = `<button class="play-all-btn" onclick="speakText('${item.word.replace(/=/g, ', ')}')">🔊 الكل</button> `;

            parts.forEach((part, index) => {
                wordsHTML += `<span class="clickable-word" onclick="speakText('${part}')">${part}</span>`;
                if (index < parts.length - 1) {
                    wordsHTML += `<span class="separator">=</span>`;
                }
            });

            tr.innerHTML = `
                <td class="num-col">${item.num}</td>
                <td class="meaning-col">${item.meaning}</td>
                <td class="word-col">
                    <div class="pron-text">${item.pron}</div>
